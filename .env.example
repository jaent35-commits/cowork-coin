# 배포 도메인 (끝 슬래시 없이). OG 태그의 og:url / og:image 절대 경로에 사용됩니다.
# 복사해서 .env.production 으로 저장 후 값을 채우세요.
VITE_SITE_URL=https://cowork-coin.example.com

# 영수증 OCR API 주소 (끝 슬래시 없이). 요청은 {이 값}/api/receipt/ocr 로 갑니다.
# - 프론트와 OCR API 가 같은 도메인에서 /api reverse proxy 를 쓰면 비워 둡니다.
# - OCR 서버가 다른 주소라면 운영 OCR API 주소를 지정합니다 (예: https://ocr.example.com).
#   이 경우 OCR 서버에 OCR_CORS_ORIGINS=프론트 도메인 을 설정해야 합니다.
# - Vite 환경변수라 빌드 시점에 적용됩니다. 값을 바꾸면 다시 빌드해야 합니다.
VITE_OCR_API_URL=

# ※ 이 파일은 프론트 빌드용입니다. OCR 서버(backend) 는 .env 파일을 읽지 않으므로
#   PADDLE_REC_ONEDNN · OCR_QUEUE_TIMEOUT · OCR_QUEUE_MAX · OCR_ENABLE_MKLDNN 등은
#   서버 실행 환경의 환경변수로 지정합니다. 목록과 기본값은 backend/README.md "환경 변수" 참고.

# Supabase 팀 로그인 (db/ERD.md §2-1 · supabase/functions)
# - 둘 다 있으면 로그인·팀 계정(추가·초기화·삭제·비밀번호 변경)을 Supabase Auth 로 처리합니다.
# - 비워 두면 지금처럼 이 브라우저 저장본으로 로그인합니다 (개발 서버 /__dev/seed 테스트 데이터용).
# - ANON_KEY 는 브라우저에 공개되는 anon(publishable) 키입니다. service_role 키는 절대 넣지 마세요.
# - 개발 서버는 .env.local, 운영 빌드는 .env.production 에 넣습니다 (둘 다 git 에 올라가지 않음).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
